# Postgres connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/aws_leaderboard?schema=public"

# Secret used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Bootstrap admin account created by `npm run seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-this-password"
SEED_ADMIN_NAME="Program Lead"
