generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  EVALUATOR
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ALUMNI
}

enum Department {
  COMPUTER_SCIENCE
  SOFTWARE_ENGINEERING
  COMPUTER_ENGINEERING
  TELECOM_ENGINEERING
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(EVALUATOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  evaluations Evaluation[]
  activities  ActivityLog[]
}

/// A time-boxed program session (e.g. "2026 Cohort"). All evaluations belong to
/// exactly one cycle so each year's record stays intact instead of being overwritten.
model Cycle {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluations     Evaluation[]
  roleAssignments RoleAssignment[]

  @@index([isActive])
}

/// A position within the builder group. Editable from the admin panel.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#FF9900")
  rank        Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments RoleAssignment[]

  @@index([rank])
}

model Student {
  id              String        @id @default(cuid())
  fullName        String
  email           String        @unique
  whatsappNumber  String?
  rollNumber      String?
  department      Department?
  bio             String?
  linkedinUrl     String?
  status          StudentStatus @default(ACTIVE)
  joinedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  evaluations     Evaluation[]
  roleAssignments RoleAssignment[]
  skills          StudentSkill[]

  @@index([status])
  @@index([fullName])
}

/// Role history: a student can hold different roles across cycles.
model RoleAssignment {
  id        String    @id @default(cuid())
  studentId String
  roleId    String
  cycleId   String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  note      String?
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  cycle   Cycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([studentId, roleId, cycleId])
  @@index([cycleId])
  @@index([studentId])
}

/// A scoring dimension (Skills, Training, Workshops, Leadership, Contributions...).
/// `weight` multiplies raw scores when computing the leaderboard total.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  weight      Float    @default(1)
  maxScore    Int      @default(10)
  color       String   @default("#0972D3")
  icon        String   @default("star")
  order       Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evaluations Evaluation[]

  @@index([order])
}

/// A single scored, justified, timestamped judgement of one student.
/// `reason` is required by design — a score with no justification cannot be
/// defended later when this data becomes the selection guideline.
model Evaluation {
  id          String   @id @default(cuid())
  studentId   String
  categoryId  String
  cycleId     String
  evaluatorId String?
  title       String
  score       Float
  maxScore    Float    @default(10)
  reason      String
  evidenceUrl String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cycle     Cycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  evaluator AdminUser? @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@index([studentId, cycleId])
  @@index([cycleId, categoryId])
  @@index([occurredAt])
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  students StudentSkill[]
}

model StudentSkill {
  studentId String
  skillId   String
  level     Int      @default(1)
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([studentId, skillId])
}

/// Audit trail — who changed what, so scores stay defensible.
model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
